/**
 * @function fd
 * @category 文件函数
 * @param path String - 文件或目录路径
 * @returns Boolean - 删除成功返回true
 * @description 删除文件或目录
 * @example
 * s result = fd("/sdcard/test.txt")
 * syso(result)
 */
fn fd(path)

/**
 * @function fe
 * @category 文件函数
 * @param path String - 文件路径
 * @returns Boolean - 文件存在返回true
 * @description 判断文件是否存在（且不是目录）
 * @example
 * s result = fe("/sdcard/test.txt")
 * syso(result)
 */
fn fe(path)

/**
 * @function fs
 * @category 文件函数
 * @param path String - 文件路径
 * @returns Long - 文件大小（字节），不存在返回-1
 * @description 获取文件大小
 * @example
 * s size = fs("/sdcard/test.txt")
 * syso(size)
 */
fn fs(path)

/**
 * @function fr
 * @category 文件函数
 * @param path String - 文件路径
 * @returns String - 文件内容
 * @description 读取文件全部内容
 * @example
 * s content = fr("/sdcard/test.txt")
 * syso(content)
 */
fn fr(path)

/**
 * @function fw
 * @category 文件函数
 * @param path String - 文件路径
 * @param content String - 写入内容
 * @param charset String - 字符编码 (可选，默认UTF-8)
 * @returns Boolean - 写入成功返回true
 * @description 写入文件内容
 * @example
 * s result = fw("/sdcard/test.txt", "Hello World")
 * syso(result)
 */
fn fw(path, content, charset)

/**
 * @function fc
 * @category 文件函数
 * @param sourcePath String - 源文件路径
 * @param destPath String - 目标文件路径
 * @param overwrite Boolean - 是否覆盖 (可选)
 * @returns Boolean - 复制成功返回true
 * @description 复制文件
 * @example
 * s result = fc("/sdcard/a.txt", "/sdcard/b.txt", true)
 * syso(result)
 */
fn fc(sourcePath, destPath, overwrite)

/**
 * @function fl
 * @category 文件函数
 * @param path String - 目录路径
 * @param filterType Boolean - 过滤类型 (可选，true=只返回目录，false=只返回文件)
 * @returns File[] - 文件数组
 * @description 列出目录内容
 * @example
 * s files = fl("/sdcard/")
 * f(files != null) {
 *     s len = sgszl(files)
 *     syso(len)
 * }
 */
fn fl(path, filterType)

/**
 * @function ft
 * @category 文件函数
 * @param sourcePath String - 源文件路径
 * @param destPath String - 目标文件路径
 * @returns Boolean - 重命名成功返回true
 * @description 重命名文件
 * @example
 * s result = ft("/sdcard/old.txt", "/sdcard/new.txt")
 * syso(result)
 */
fn ft(sourcePath, destPath)

/**
 * @function fdir
 * @category 文件函数
 * @param type String - 目录类型 (可选: "app", "data", "cache", "files", "external")
 * @returns String - 目录路径
 * @description 获取目录路径
 * @example
 * s path = fdir("app")
 * syso(path)
 */
fn fdir(type)

/**
 * @function fuz
 * @category 文件函数
 * @param zipPath String - ZIP文件路径
 * @param entryName String - ZIP内的文件名
 * @param destPath String - 解压目标路径
 * @param overwrite Boolean - 是否覆盖 (可选)
 * @returns Boolean - 解压成功返回true
 * @description 解压ZIP中的单个文件
 * @example
 * s result = fuz("/sdcard/test.zip", "file.txt", "/sdcard/output/")
 * syso(result)
 */
fn fuz(zipPath, entryName, destPath, overwrite)

/**
 * @function fuzs
 * @category 文件函数
 * @param zipPath String - ZIP文件路径
 * @param destPath String - 解压目标路径
 * @returns Boolean - 解压成功返回true
 * @description 解压整个ZIP文件
 * @example
 * s result = fuzs("/sdcard/test.zip", "/sdcard/output/")
 * syso(result)
 */
fn fuzs(zipPath, destPath)

/**
 * @function fj
 * @category 文件函数
 * @param sourcePath String - 源文件/目录路径
 * @param zipPath String - ZIP文件路径
 * @param includeRoot Boolean - 是否包含根目录 (可选)
 * @returns Boolean - 压缩成功返回true
 * @description 将文件/目录压缩为ZIP
 * @example
 * s result = fj("/sdcard/folder/", "/sdcard/archive.zip")
 * syso(result)
 */
fn fj(sourcePath, zipPath, includeRoot)

/**
 * @function fo
 * @category 文件函数
 * @param source String - 源文件路径
 * @param dest String - 目标文件路径
 * @returns Boolean - 移动成功返回true
 * @description 移动文件
 * @example
 * s result = fo("/sdcard/a.txt", "/sdcard/subdir/a.txt")
 * syso(result)
 */
fn fo(source, dest)

/**
 * @function fi
 * @category 文件函数
 * @param path String - 路径
 * @returns Boolean - 是目录返回true
 * @description 判断路径是否为目录
 * @example
 * s result = fi("/sdcard/folder/")
 * syso(result)
 */
fn fi(path)
