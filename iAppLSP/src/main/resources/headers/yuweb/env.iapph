/**
 * @function env
 * @category Web环境变量函数
 * @yuweb
 * @param key String - 环境变量名
 * @param default String - 默认值 (可选)
 * @returns String - 环境变量值
 * @description 获取环境变量值
 * @example
 * s dbHost = env("DB_HOST", "localhost")
 * s dbPort = env("DB_PORT", "3306")
 * syso(dbHost + ":" + dbPort)
 */
fn env(key, default)

/**
 * @function loadenv
 * @category Web环境变量函数
 * @yuweb
 * @param path String - .env文件路径 (可选)
 * @returns Boolean - 加载成功返回true
 * @description 加载.env配置文件
 * @example
 * loadenv()  // 加载当前目录下的.env文件
 * loadenv("/config/.env")  // 加载指定路径的.env文件
 */
fn loadenv(path)
