port(8080)

db("sqlite", "C:/Users/Administrator/IdeaProjects/iapp-runner/YuWeb/example/data/app.db")

dbexec("CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT UNIQUE NOT NULL,
    password TEXT NOT NULL,
    email TEXT,
    status TEXT DEFAULT 'active',
    created_at INTEGER
)")

dbexec("CREATE TABLE IF NOT EXISTS posts (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    content TEXT,
    user_id INTEGER,
    created_at INTEGER
)")

syso("YuWeb Server 启动成功")
syso("端口: 8080")
syso("访问: http://localhost:8080")
