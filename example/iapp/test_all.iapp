syso("")
syso("=== 第二部分：控制流测试 ===")
syso("")

// 测试22：if条件成立
s if_test1 = 0
f(1 == 1)
{
    s(if_test1 + 1, if_test1)
}
f(if_test1 == 1)
{
    test_report("if条件成立", true)
}
else
{
    test_report("if条件成立", false)
}

// 测试23：if条件不成立
s if_test2 = 0
f(1 == 2)
{
    s(if_test2 + 1, if_test2)
}
f(if_test2 == 0)
{
    test_report("if条件不成立", true)
}
else
{
    test_report("if条件不成立", false)
}

// 测试24：if-else
s if_test3 = 0
f(1 == 2)
{
    s(if_test3 + 1, if_test3)
}
else
{
    s(if_test3 + 2, if_test3)
}
f(if_test3 == 2)
{
    test_report("if-else", true)
}
else
{
    test_report("if-else", false)
}

// 测试25：if-else if-else
s if_test4 = 0
s cond_val = 2
f(cond_val == 1)
{
    s(if_test4 + 1, if_test4)
}
else f(cond_val == 2)
{
    s(if_test4 + 2, if_test4)
}
else
{
    s(if_test4 + 3, if_test4)
}
f(if_test4 == 2)
{
    test_report("if-else if-else", true)
}
else
{
    test_report("if-else if-else", false)
}

// 测试26：嵌套if
s if_test5 = 0
f(1 == 1)
{
    f(2 == 2)
    {
        s(if_test5 + 1, if_test5)
    }
}
f(if_test5 == 1)
{
    test_report("嵌套if", true)
}
else
{
    test_report("嵌套if", false)
}

// 测试27：while循环
s w_count = 0
s w_i = 0
w(w_i < 5)
{
    s(w_count + 1, w_count)
    s(w_i + 1, w_i)
}
f(w_count == 5)
{
    test_report("while循环", true)
}
else
{
    test_report("while循环", false)
}

// 测试28：while嵌套
s w_nest = 0
s w_i2 = 0
w(w_i2 < 3)
{
    s w_j = 0
    w(w_j < 2)
    {
        s(w_nest + 1, w_nest)
        s(w_j + 1, w_j)
    }
    s(w_i2 + 1, w_i2)
}
f(w_nest == 6)
{
    test_report("while嵌套", true)
}
else
{
    test_report("while嵌套", false)
}

// 测试29：for范围循环
s for_count1 = 0
for(1; 5)
{
    s(for_count1 + 1, for_count1)
}
f(for_count1 == 5)
{
    test_report("for范围循环", true)
}
else
{
    test_report("for范围循环", false)
}

// 测试30：for变量范围循环
