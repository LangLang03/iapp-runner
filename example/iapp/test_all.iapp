============================================
  第三部分：函数与线程测试
============================================
./

syso("")
syso("=== 第三部分：函数与线程测试 ===")
syso("")

// 定义测试函数
fn add_func(a, b)
    sss result = a + b
    syso("add_func result: " + result)
end fn

fn multiply_func(a, b)
    sss result = a * b
end fn

fn no_param_func()
    syso("no_param_func called")
end fn

fn nested_func(a)
    sss nested_b = a + 10
    multiply_func(nested_b, 2)
end fn

// 测试41：有参函数调用
add_func(3, 5)
f(result == 8)
{
    test_report("有参函数调用", true)
}
else
{
    test_report("有参函数调用", false)
}

// 测试42：无参函数调用
no_param_func()
test_report("无参函数调用", true)

// 测试43：函数返回值
multiply_func(4, 5)
f(result == 20)
{
    test_report("函数返回值", true)
}
else
{
    test_report("函数返回值", false)
}

// 测试44：函数嵌套调用
nested_func(5)
syso("nested_func result: " + result)
f(result == 30)
{
    test_report("函数嵌套调用", true)
}
else
{
    test_report("函数嵌套调用", false)
}

// 测试45：线程执行
s thread_test = 0
t()
{
    s(thread_test + 1, thread_test)
    syso("thread executed")
}
stop(100)
f(thread_test == 1)
{
    test_report("线程执行", true)
}
else
{
    test_report("线程执行", false)
}

