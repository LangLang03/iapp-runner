f(concat1 == "hello world")
{
    test_report("字符串拼接", true)
}
else
{
    test_report("字符串拼接", false)
}

// 测试16：表达式计算
s expr1 = (10 + 5) * 2 - 5
f(expr1 == 25)
{
    test_report("表达式计算", true)
}
else
