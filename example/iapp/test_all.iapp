s for_count2 = 0
for(for_start; for_end)
{
    s(for_count2 + 1, for_count2)
}
f(for_count2 == 5)
{
    test_report("for变量范围循环", true)
}
else
{
    test_report("for变量范围循环", false)
}

// 测试31：for数组遍历
s for_arr_sum = 0
nsz(5, for_arr)
sssz(for_arr, 0, 1)
sssz(for_arr, 1, 2)
sssz(for_arr, 2, 3)
sssz(for_arr, 3, 4)
sssz(for_arr, 4, 5)
for(item; for_arr)
{
    s(for_arr_sum + item, for_arr_sum)
}
f(for_arr_sum == 15)
{
    test_report("for数组遍历", true)
}
else
{
    test_report("for数组遍历", false)
}

// 测试32：for C风格循环
s for_c_sum = 0
for(s i=1; i<=5; i++)
{
    s(for_c_sum + i, for_c_sum)
}
f(for_c_sum == 15)
{
    test_report("for C风格循环", true)
}
else
{
    test_report("for C风格循环", false)
}

// 测试33：for C风格递减
s for_c_dec = 0
for(s i=5; i>0; i--)
{
    s(for_c_dec + 1, for_c_dec)
}
f(for_c_dec == 5)
{
    test_report("for C风格递减", true)
}
else
{
    test_report("for C风格递减", false)
}

// 测试34：break跳出while
s break_test1 = 0
s break_i = 0
w(break_i < 100)
{
    s(break_test1 + 1, break_test1)
    f(break_test1 == 5)
    {
        break
    }
    s(break_i + 1, break_i)
}
f(break_test1 == 5)
{
    test_report("break跳出while", true)
}
else
{
    test_report("break跳出while", false)
}

// 测试35：break跳出for
s break_test2 = 0
for(1; 100)
{
    s(break_test2 + 1, break_test2)
    f(break_test2 == 10)
    {
        break
    }
}
f(break_test2 == 10)
{
    test_report("break跳出for", true)
}
else
{
    test_report("break跳出for", false)
}

// 测试36：单变量判断-非零数字
s single_var1 = 123
s single_result1 = false
f(single_var1)
{
    s(true, single_result1)
}
f(single_result1 == true)
{
    test_report("单变量判断-非零数字", true)
}
else
{
    test_report("单变量判断-非零数字", false)
}

// 测试37：单变量判断-零
