/.
============================================
  iApp Runner 兼容性测试脚本
  测试所有支持的语法和内置函数
  生成时间: 2026-03-05
============================================
./

s test_total = 0
s test_pass = 0
s test_fail = 0

fn test_report(name, passed)
    s(test_total + 1, test_total)
    f(passed == true)
    {
        s(test_pass + 1, test_pass)
        syso("[PASS] " + name)
    }
    else
    {
        s(test_fail + 1, test_fail)
        syso("[FAIL] " + name)
    }
end fn

syso("============================================")
syso("  iApp Runner 兼容性测试脚本")
syso("============================================")
syso("")

/.
============================================
  第一部分：基础语法测试
============================================
./

syso("")
syso("=== 第一部分：基础语法测试 ===")
syso("")

// 测试1：局部变量声明
s var1 = 123
f(var1 == 123)
{
    test_report("局部变量声明", true)
}
else
{
    test_report("局部变量声明", false)
}

// 测试2：界面变量声明
ss var2 = "hello"
f(var2 == "hello")
{
    test_report("界面变量声明", true)
}
else
{
    test_report("界面变量声明", false)
}

// 测试3：全局变量声明
sss var3 = true
f(var3 == true)
{
    test_report("全局变量声明", true)
}
else
{
    test_report("全局变量声明", false)
}

// 测试4：变量不赋值默认为null
s var4
f(var4 == null)
{
    test_report("变量默认null", true)
}
else
{
    test_report("变量默认null", false)
}

// 测试5：数字字面量
s num1 = 123
s num2 = 3.14
f(num1 == 123 && num2 == 3.14)
{
    test_report("数字字面量", true)
}
else
{
    test_report("数字字面量", false)
}

// 测试6：字符串字面量
s str1 = "hello world"
f(str1 == "hello world")
{
    test_report("字符串字面量", true)
}
else
{
    test_report("字符串字面量", false)
}

// 测试7：布尔字面量
s bool1 = true
s bool2 = false
f(bool1 == true && bool2 == false)
{
    test_report("布尔字面量", true)
}
else
{
    test_report("布尔字面量", false)
}

// 测试8：null字面量
s null1 = null
f(null1 == null)
{
    test_report("null字面量", true)
}
else
{
    test_report("null字面量", false)
}

// 测试9：算术运算符
s arith1 = 10 + 5
s arith2 = 10 - 5
s arith3 = 10 * 5
s arith4 = 10 / 5
s arith5 = 10 % 3
f(arith1 == 15 && arith2 == 5 && arith3 == 50 && arith4 == 2 && arith5 == 1)
{
    test_report("算术运算符", true)
}
else
{
    test_report("算术运算符", false)
}

// 测试10：比较运算符
s cmp1 = 5 == 5
s cmp2 = 5 != 3
s cmp3 = 5 > 3
s cmp4 = 5 < 10
s cmp5 = 5 >= 5
s cmp6 = 5 <= 5
f(cmp1 && cmp2 && cmp3 && cmp4 && cmp5 && cmp6)
{
    test_report("比较运算符", true)
}
else
{
    test_report("比较运算符", false)
}

// 测试11：逻辑运算符
s log1 = true && true
s log2 = true || false
s log3 = !false
f(log1 && log2 && log3)
{
    test_report("逻辑运算符", true)
}
else
{
    test_report("逻辑运算符", false)
}

// 测试12：字符串开头匹配 ?*
s str_match1 = "hello world"
s match1 = str_match1 ?* "hello"
f(match1 == true)
{
    test_report("字符串开头匹配 ?*", true)
}
else
{
    test_report("字符串开头匹配 ?*", false)
}

// 测试13：字符串结尾匹配 *?
s str_match2 = "hello world"
s match2 = str_match2 *? "world"
f(match2 == true)
{
    test_report("字符串结尾匹配 *?", true)
}
else
{
    test_report("字符串结尾匹配 *?", false)
}

// 测试14：字符串包含匹配 ?
s str_match3 = "hello world"
s match3 = str_match3 ? "lo wo"
f(match3 == true)
{
    test_report("字符串包含匹配 ?", true)
}
else
{
    test_report("字符串包含匹配 ?", false)
}

// 测试15：字符串拼接
