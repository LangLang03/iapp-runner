// 测试102：嵌套控制流
s nest_result = 0
for(s i=1; i<=3; i++)
{
    f(i == 2)
    {
        s(nest_result + 10, nest_result)
    }
    else
    {
        s(nest_result + 1, nest_result)
    }
}
f(nest_result == 12)
{
    test_report("嵌套控制流", true)
}
else
{
    test_report("嵌套控制流", false)
}

// 测试103：函数递归计算阶乘
sss fact_result = 1
fn factorial(n)
    sss fact_result = 1
    s i = 1
    w(i <= n)
    {
        sss fact_result = fact_result * i
        s(i + 1, i)
    }
end fn

factorial(5)
f(fact_result == 120)
{
    test_report("函数递归计算阶乘", true)
}
else
{
    test_report("函数递归计算阶乘", false)
}

