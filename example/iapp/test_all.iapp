    test_report("表达式计算", false)
}

// 测试17：复合表达式
s a = 10
s b = 20
s expr2 = a + b * 2
f(expr2 == 50)
{
    test_report("复合表达式", true)
}
else
{
    test_report("复合表达式", false)
}

// 测试18：括号改变优先级
s expr3 = (10 + 5) * (2 + 3)
f(expr3 == 75)
{
    test_report("括号改变优先级", true)
}
else
{
    test_report("括号改变优先级", false)
}

// 测试19：数组创建和访问
nsz(3, arr1)
sssz(arr1, 0, "a")
sssz(arr1, 1, "b")
sssz(arr1, 2, "c")
sgsz(arr1, 0, arr_val1)
sgsz(arr1, 1, arr_val2)
sgsz(arr1, 2, arr_val3)
f(arr_val1 == "a" && arr_val2 == "b" && arr_val3 == "c")
{
    test_report("数组创建和访问", true)
}
else
{
    test_report("数组创建和访问", false)
}

// 测试20：数组长度
sgszl(arr1, arr_len1)
f(arr_len1 == 3)
{
    test_report("数组长度", true)
}
else
{
    test_report("数组长度", false)
}

// 测试21：数组索引访问表达式
